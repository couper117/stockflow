# Copy to .env:  cp .env.example .env
# Everything here has a working local default. The app validates these at boot
# (src/lib/env.ts) and exits with a clear message if any is missing/malformed.

# --- docker-compose Postgres service (root) ---
DB_DATABASE=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=secret
DB_PORT=5432

# --- Application database connections ---
# Runtime role: sf_app — NO BYPASSRLS. Tenant isolation depends on this.
DATABASE_URL=postgres://stockflow:secret@localhost:5432/stockflow
# Migration role: sf_migrate — owns the schema, runs DDL (used by drizzle-kit).
DATABASE_URL_MIGRATE=postgres://stockflow:secret@localhost:5432/stockflow

# --- Session / auth ---
SESSION_COOKIE_NAME=sf_session
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60

# --- Web / i18n ---
WEB_ORIGIN=http://localhost:3000
DEFAULT_LANGUAGE=en
LOG_LEVEL=info

# --- Rate limits (requests / window) ---
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_TIN_LOOKUP_PER_MIN=10
RATE_LIMIT_API_PER_MIN=100

# --- Mail (local dev uses Mailpit; see docker-compose if enabled) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@stockflow.local
